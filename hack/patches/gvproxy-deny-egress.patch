+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"strconv"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+)
+
+// wolfcowGuestHandler serves a local synthetic fixture and policy-gated CONNECT.
+// The fixture performs no DNS lookup or host dial. CONNECT resolves and dials
+// only destinations allowed by the exact hostname and port policy.
+func wolfcowGuestHandler(policy wolfcowPolicy) http.Handler {
+	return wolfcowGuestHandlerWithNetwork(policy, net.DefaultResolver.LookupNetIP,
+		(&net.Dialer{Timeout: 5 * time.Second}).DialContext)
+}
+
+func wolfcowGuestHandlerWithNetwork(
+	policy wolfcowPolicy,
+	lookup func(context.Context, string, string) ([]netip.Addr, error),
+	dial func(context.Context, string, string) (net.Conn, error),
+) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodConnect {
+			wolfcowConnect(w, r, policy, lookup, dial)
+			return
+		}
+		if r.Method == http.MethodGet && !r.URL.IsAbs() &&
+			(r.Host == "192.168.127.1" || r.Host == "192.168.127.1:80") &&
+			r.URL.Path == "/wolfcow/health" &&
+			r.URL.RawQuery == "" {
+			_, _ = w.Write([]byte("wolfcow network ready\n"))
+			return
+		}
+
+		if r.Method == http.MethodGet && r.URL.IsAbs() &&
+			r.URL.Scheme == "http" && r.URL.Hostname() == "allowed.wolfcow.invalid" &&
+			(r.URL.Port() == "" || r.URL.Port() == "80") && r.URL.User == nil &&
+			r.URL.Path == "/probe" && r.URL.RawQuery == "" &&
+			r.URL.Fragment == "" {
+			w.Header().Set("Content-Type", "application/json")
+			w.Header().Set("Cache-Control", "no-store")
+			_, _ = w.Write([]byte("{\"ok\":true,\"endpoint\":\"synthetic\"}\n"))
+			return
+		}
+
+		// A bounded diagnostic for the hidden development probe. It reveals no
+		// request value or credential and helps distinguish parsing from policy.
+		diagnostic := fmt.Sprintf("get=%t absolute=%t scheme=%t name=%t port=%t route=%t query_empty=%t user_nil=%t fragment_empty=%t",
+			r.Method == http.MethodGet, r.URL.IsAbs(), r.URL.Scheme == "http",
+			r.URL.Hostname() == "allowed.wolfcow.invalid", r.URL.Port() == "" || r.URL.Port() == "80",
+			r.URL.Path == "/probe", r.URL.RawQuery == "", r.URL.User == nil,
+			r.URL.Fragment == "")
+		w.Header().Set("X-Wolfcow-Policy", diagnostic)
+		log.Infof("wolfcow synthetic proxy denied: %s", diagnostic)
+		http.Error(w, "wolfcow: destination denied", http.StatusForbidden)
+	})
+}
+
+func wolfcowConnect(
+	w http.ResponseWriter, r *http.Request, policy wolfcowPolicy,
+	lookup func(context.Context, string, string) ([]netip.Addr, error),
+	dial func(context.Context, string, string) (net.Conn, error),
+) {
+	target := r.URL.Host
+	host, portText, err := net.SplitHostPort(target)
+	if err != nil || r.URL.Scheme != "" || r.URL.Path != "" ||
+		(r.RequestURI != "" && r.RequestURI != target) || !wolfcowValidHost(host) {
+		http.Error(w, "wolfcow: destination denied", http.StatusForbidden)
+		return
+	}
+	portNumber, err := strconv.ParseUint(portText, 10, 16)
+	if err != nil || !policy.allows(host, uint16(portNumber)) {
+		http.Error(w, "wolfcow: destination denied", http.StatusForbidden)
+		return
+	}
+	dialCtx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+	defer cancel()
+	address, err := wolfcowResolvePublic(dialCtx, host, lookup)
+	if err != nil {
+		var failure *wolfcowResolveFailure
+		if errors.As(err, &failure) {
+			w.Header().Set("X-Wolfcow-Connect-Error", failure.Kind)
+		} else {
+			w.Header().Set("X-Wolfcow-Connect-Error", "resolve")
+		}
+		if errors.Is(err, context.Canceled) {
+			w.Header().Set("X-Wolfcow-DNS-Detail", "canceled")
+		} else if errors.Is(err, context.DeadlineExceeded) {
+			w.Header().Set("X-Wolfcow-DNS-Detail", "deadline")
+		} else {
+			var dnsError *net.DNSError
+			if errors.As(err, &dnsError) {
+				switch {
+				case dnsError.IsTimeout:
+					w.Header().Set("X-Wolfcow-DNS-Detail", "timeout")
+				case dnsError.IsNotFound:
+					w.Header().Set("X-Wolfcow-DNS-Detail", "not-found")
+				case dnsError.IsTemporary:
+					w.Header().Set("X-Wolfcow-DNS-Detail", "temporary")
+				default:
+					w.Header().Set("X-Wolfcow-DNS-Detail", "other")
+				}
+			}
+		}
+		http.Error(w, "wolfcow: destination unavailable", http.StatusBadGateway)
+		return
+	}
+	outbound, err := dial(dialCtx, "tcp", net.JoinHostPort(address.String(), portText))
+	if err != nil {
+		w.Header().Set("X-Wolfcow-Connect-Error", "dial")
+		http.Error(w, "wolfcow: destination unavailable", http.StatusBadGateway)
+		return
+	}
+	defer outbound.Close()
+	hijacker, ok := w.(http.Hijacker)
+	if !ok {
+		http.Error(w, "wolfcow: transport unavailable", http.StatusInternalServerError)
+		return
+	}
+	guest, buffered, err := hijacker.Hijack()
+	if err != nil {
+		return
+	}
+	defer guest.Close()
+	if _, err := fmt.Fprint(buffered, "HTTP/1.1 200 Connection Established\r\n\r\n"); err != nil {
+		return
+	}
+	if err := buffered.Flush(); err != nil {
+		return
+	}
+	done := make(chan struct{})
+	go func() {
+		_, _ = io.Copy(outbound, buffered)
+		close(done)
+	}()
+	_, _ = io.Copy(guest, outbound)
+	_ = guest.Close()
+	_ = outbound.Close()
+	<-done
+}
