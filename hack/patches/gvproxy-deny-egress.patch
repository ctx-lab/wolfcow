+func TestWolfcowDestinationPolicy(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "policy.json")
+	if err := os.WriteFile(path, []byte(`{"tcp":[{"host":"example.org","port":443}]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	policy, err := wolfcowLoadPolicy(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !policy.allows("example.org", 443) || policy.allows("example.org", 80) || policy.allows("other.org", 443) {
+		t.Fatal("destination match is not exact")
+	}
+	for _, malformed := range []string{
+		`{"tcp":[{"host":"127.0.0.1","port":443}]}`,
+		`{"tcp":[{"host":"*.example.org","port":443}]}`,
+		`{"tcp":[{"host":"example.org","port":443},{"host":"example.org","port":443}]}`,
+		`{"tcp":[],"unexpected":true}`,
+	} {
+		if err := os.WriteFile(path, []byte(malformed), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := wolfcowLoadPolicy(path); err == nil {
+			t.Errorf("accepted %s", malformed)
+		}
+	}
+}
