+func TestWolfcowConnectPinsResolvedIPAndTunnels(t *testing.T) {
+	guest, gateway := net.Pipe()
+	defer guest.Close()
+	outbound, remote := net.Pipe()
+	defer remote.Close()
+	request, err := http.ReadRequest(bufio.NewReader(strings.NewReader("CONNECT example.org:443 HTTP/1.1\r\nHost: example.org:443\r\n\r\n")))
+	if err != nil {
+		t.Fatal(err)
+	}
+	lookup := func(_ context.Context, network, host string) ([]netip.Addr, error) {
+		if network != "ip4" || host != "example.org." {
+			return nil, fmt.Errorf("lookup %s %s", network, host)
+		}
+		return []netip.Addr{netip.MustParseAddr("8.8.8.8")}, nil
+	}
+	dial := func(_ context.Context, network, address string) (net.Conn, error) {
+		if network != "tcp" || address != "8.8.8.8:443" {
+			return nil, fmt.Errorf("dial %s %s", network, address)
+		}
+		return outbound, nil
+	}
+	handler := wolfcowGuestHandlerWithNetwork(wolfcowPolicy{TCP: []wolfcowDestination{{Host: "example.org", Port: 443}}}, lookup, dial)
+	done := make(chan struct{})
+	go func() {
+		handler.ServeHTTP(&wolfcowHijackWriter{conn: gateway, header: make(http.Header)}, request)
+		close(done)
+	}()
+	_ = guest.SetDeadline(time.Now().Add(2 * time.Second))
+	_ = remote.SetDeadline(time.Now().Add(2 * time.Second))
+	reader := bufio.NewReader(guest)
+	status, err := reader.ReadString('\n')
+	if err != nil || !strings.Contains(status, "200 Connection Established") {
+		t.Fatalf("status %q: %v", status, err)
+	}
+	if _, err := reader.ReadString('\n'); err != nil {
+		t.Fatal(err)
+	}
+	remoteDone := make(chan error, 1)
+	go func() {
+		payload := make([]byte, 4)
+		_, err := io.ReadFull(remote, payload)
+		if err == nil && string(payload) != "ping" {
+			err = fmt.Errorf("payload %q", payload)
+		}
+		if err == nil {
+			_, err = remote.Write([]byte("pong"))
+		}
+		remoteDone <- err
+		_ = remote.Close()
+	}()
+	if _, err := guest.Write([]byte("ping")); err != nil {
+		t.Fatal(err)
+	}
+	payload := make([]byte, 4)
+	if _, err := io.ReadFull(reader, payload); err != nil || string(payload) != "pong" {
+		t.Fatalf("response %q: %v", payload, err)
+	}
+	if err := <-remoteDone; err != nil {
+		t.Fatal(err)
+	}
+	_ = guest.Close()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("proxy did not stop after tunnel closed")
+	}
+}
