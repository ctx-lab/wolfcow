+type wolfcowHijackWriter struct {
+	conn   net.Conn
+	header http.Header
+}
+
+func (w *wolfcowHijackWriter) Header() http.Header            { return w.header }
+func (w *wolfcowHijackWriter) Write(data []byte) (int, error) { return w.conn.Write(data) }
+func (w *wolfcowHijackWriter) WriteHeader(int)                {}
+func (w *wolfcowHijackWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
