+func TestWolfcowSyntheticProxyPolicy(t *testing.T) {
+	handler := wolfcowGuestHandler(wolfcowPolicy{})
+	tests := []struct {
+		name   string
+		method string
+		uri    string
+		host   string
+		status int
+	}{
+		{"allowed", "GET", "http://allowed.wolfcow.invalid/probe", "allowed.wolfcow.invalid", http.StatusOK},
+		{"explicit default port", "GET", "http://allowed.wolfcow.invalid:80/probe", "allowed.wolfcow.invalid", http.StatusOK},
+		{"blocked name", "GET", "http://blocked.example/probe", "blocked.example", http.StatusForbidden},
+		{"hostname suffix", "GET", "http://allowed.wolfcow.invalid.evil/probe", "allowed.wolfcow.invalid.evil", http.StatusForbidden},
+		{"userinfo", "GET", "http://blocked.example@allowed.wolfcow.invalid/probe", "allowed.wolfcow.invalid", http.StatusForbidden},
+		{"raw IP", "GET", "http://198.51.100.1/probe", "198.51.100.1", http.StatusForbidden},
+		{"other port", "GET", "http://allowed.wolfcow.invalid:8080/probe", "allowed.wolfcow.invalid:8080", http.StatusForbidden},
+		{"TLS tunnel", "CONNECT", "https://allowed.wolfcow.invalid/", "allowed.wolfcow.invalid", http.StatusForbidden},
+		{"other route", "GET", "http://allowed.wolfcow.invalid/other", "allowed.wolfcow.invalid", http.StatusForbidden},
+		{"redirect route", "GET", "http://allowed.wolfcow.invalid/redirect", "allowed.wolfcow.invalid", http.StatusForbidden},
+		{"query", "GET", "http://allowed.wolfcow.invalid/probe?next=http://blocked.example", "allowed.wolfcow.invalid", http.StatusForbidden},
+		{"conflicting Host header ignored", "GET", "http://allowed.wolfcow.invalid/probe", "blocked.example", http.StatusOK},
+		{"connect", "CONNECT", "http://allowed.wolfcow.invalid/probe", "allowed.wolfcow.invalid", http.StatusForbidden},
+		{"gateway via proxy", "GET", "http://allowed.wolfcow.invalid/wolfcow/health", "allowed.wolfcow.invalid", http.StatusForbidden},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			r := &http.Request{Method: tc.method, URL: mustWolfcowURL(t, tc.uri), Host: tc.host, Header: make(http.Header)}
+			w := httptest.NewRecorder()
+			handler.ServeHTTP(w, r)
+			if w.Code != tc.status {
+				t.Fatalf("status = %d, want %d: %s", w.Code, tc.status, w.Body.String())
+			}
+			if tc.status == http.StatusOK {
+				if !strings.Contains(w.Body.String(), `"endpoint":"synthetic"`) || w.Header().Get("Location") != "" {
+					t.Fatalf("unexpected response: headers %v, body %s", w.Header(), w.Body.String())
+				}
+			}
+		})
+	}
+
+	t.Run("origin form cannot forge allowed host", func(t *testing.T) {
+		r := &http.Request{Method: http.MethodGet, URL: &url.URL{Path: "/probe"}, Host: "allowed.wolfcow.invalid"}
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, r)
+		if w.Code != http.StatusForbidden {
+			t.Fatalf("status = %d, want forbidden", w.Code)
+		}
+	})
+	t.Run("gateway health", func(t *testing.T) {
+		for _, host := range []string{"192.168.127.1", "192.168.127.1:80"} {
+			r := &http.Request{Method: http.MethodGet, URL: &url.URL{Path: "/wolfcow/health"}, Host: host}
+			w := httptest.NewRecorder()
+			handler.ServeHTTP(w, r)
+			if w.Code != http.StatusOK || w.Body.String() != "wolfcow network ready\n" {
+				t.Fatalf("health host = %q, status = %d, body = %q", host, w.Code, w.Body.String())
+			}
+		}
+	})
+	t.Run("absolute request target on wire", func(t *testing.T) {
+		r, err := http.ReadRequest(bufio.NewReader(strings.NewReader("GET http://allowed.wolfcow.invalid/probe HTTP/1.1\r\nHost: 192.168.127.1\r\n\r\n")))
+		if err != nil {
+			t.Fatal(err)
+		}
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, r)
+		if w.Code != http.StatusOK {
+			t.Fatalf("status = %d, URL = %#v, Host = %q", w.Code, r.URL, r.Host)
+		}
+	})
+	t.Run("gateway health with explicit port on wire", func(t *testing.T) {
+		r, err := http.ReadRequest(bufio.NewReader(strings.NewReader("GET /wolfcow/health HTTP/1.1\r\nHost: 192.168.127.1:80\r\n\r\n")))
